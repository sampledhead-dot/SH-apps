<?xml version="1.0" encoding="utf-8"?>
<!-- Solo se permite HTTP sin cifrar hacia Melodee en la MPC Sample conectada por USB-C (melodee.local / 192.168.155.1). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">melodee.local</domain>
        <domain includeSubdomains="false">192.168.155.1</domain>
    </domain-config>
</network-security-config>
